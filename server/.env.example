# Copy to server/.env and fill in real values. Never commit server/.env.

# --- Required for production ---
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=False
# Leave unset to default to safebangle.com, www.safebangle.com, api.safebangle.com
# (localhost is auto-added only when DJANGO_DEBUG=True)
# DJANGO_ALLOWED_HOSTS=safebangle.com,www.safebangle.com,api.safebangle.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://safebangle.com,https://www.safebangle.com,https://api.safebangle.com
SAFECHECK_ALLOW_MOCK_AUTH=false

# Database (use DATABASE_URL or individual fields)
# DATABASE_URL=postgresql://user:pass@host:5432/safebangle
DB_ENGINE=django.db.backends.postgresql
DB_NAME=safebangle
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Email verification (required when DJANGO_DEBUG=False)
# Common providers: Gmail, SendGrid, Mailgun, Amazon SES, Resend SMTP.
# Gmail: enable 2FA and create an App Password for EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@safebangle.com
EMAIL_FROM_NAME=SafeBangle
EMAIL_VERIFICATION_SUBJECT=Your SafeBangle verification code
EMAIL_VERIFICATION_EXPIRY_MINUTES=10

# Africa's Talking (SMS/voice escalation)
VOICE_SMS_PROVIDER=africastalking
AT_VOICE_BASE_URL=https://voice.africastalking.com
AT_SMS_BASE_URL=https://api.africastalking.com/version1/messaging
AT_SMS_BULK_URL=https://api.africastalking.com/version1/messaging/bulk
AT_USERNAME=
AT_API_KEY=
# Optional. Only set after Africa's Talking approves your alphanumeric sender ID.
# If invalid, SMS fails with InvalidSenderId — leave empty to use AT default.
AT_SENDER_ID=

# Public URL for voice/SMS webhooks (HTTPS in production)
CALLBACK_BASE_URL=https://api.safebangle.com

# Firebase Admin for server-driven check-in push
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Optional HTTPS hardening
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
