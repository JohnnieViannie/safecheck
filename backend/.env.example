DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,server.safebangle.com,safebangle.com,www.safebangle.com,api.safebangle.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://server.safebangle.com,https://safebangle.com,https://www.safebangle.com,http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://safebangle.com,https://www.safebangle.com

# Database (defaults to sqlite if unset)
# DATABASE_URL=
# DB_ENGINE=django.db.backends.sqlite3

FRONTEND_URL=http://localhost:3000
SAFECHECK_PUBLIC_BASE_URL=https://safebangle.com
# SAFECHECK_ALLOW_MOCK_AUTH=1

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SafeBangle <hello@safebangle.com>
EMAIL_FROM=hello@safebangle.com
EMAIL_FROM_NAME=SafeBangle

# Africa's Talking — outbound SOS / escalation SMS
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# AT_SMS_URL=https://api.africastalking.com/version1/messaging
# AT_SMS_BASE_URL=https://api.africastalking.com/version1/messaging
SMS_PROVIDER=kacyber
VOICE_SMS_PROVIDER=africastalking

# KaCyber SMS (used when SMS_PROVIDER=kacyber)
KACYBER_ENV=sandbox
KACYBER_APP_ID=
KACYBER_API_KEY=
KACYBER_SENDER_ID=KaCyber
# Optional override:
# KACYBER_SMS_BASE_URL=https://kacyberpay.com/api/v1/comms/sms
CALLBACK_BASE_URL=https://api.safebangle.com

# Firebase Admin (mobile check-in push)
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON=

# Inbound SMS webhook (Africa's Talking → SafeBangle)
WEBHOOK_SHARED_SECRET=

# Bracelet HTTP SOS endpoints (X-Bracelet-Secret header)
BRACELET_API_SECRET=

# OpenCellID cell-tower fallback for GPS-less SOS
OPENCELLID_API_KEY=
# OPENCELLID_BASE_URL=https://opencellid.org

# Nominatim reverse geocoding (OpenStreetMap)
# NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_USER_AGENT=SafeBangle/1.0 (alerts@safebangle.com)
# GEO_HTTP_TIMEOUT=8

# Optional SMS body parser override
# BRACELET_SMS_REGEX=^SB\|(?P<device_id>[^|]+)\|(?P<alert_code>[^|]+)\|(?P<lat>-?\d+(?:\.\d+)?)\|(?P<lng>-?\d+(?:\.\d+)?)$

# Optional: import from legacy SafeCheck server DB
# LEGACY_DATABASE_URL=postgresql://user:pass@host:5432/safebangle
